Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Assume", " ", "constant", " ", "impedance"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Assume", " ", "1", " ", "dimension"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Assume", " ", "no", " ", "beam", " ", 
    RowBox[{"i", ".", "e", ".", " ", "unloaded"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "vzero", " ", "unloaded", " ", "constant", " ", "impedance", " ", "energy",
     " ", "gain", " ", "of", " ", "whole", " ", "structure"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vzero", "[", 
     RowBox[{"r_", ",", "L_", ",", "tau_", ",", "pzero_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "*", "L", "*", "pzero"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "/", "tau"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"-", "tau"}], ")"}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"vzero", "[", 
       RowBox[{"r", ",", "L", ",", "tau", ",", "pzero"}], "]"}], "/", 
      "mega"}], ",", 
     RowBox[{"{", 
      RowBox[{"tau", ",", "0.5", ",", "2.5"}], "}"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"MaTeX", "[", "\"\<\\\\tau\>\"", "]"}], ",", 
        RowBox[{"MaTeX", "[", "\"\<V_0\\\\ [MV]\>\"", "]"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",

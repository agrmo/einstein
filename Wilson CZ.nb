Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Get", "[", 
   "\"\<https://raw.githubusercontent.com/mark-caprio/CustomTicks/master/\
CustomTicks.m\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<MaTeX`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConfigureMaTeX", "[", 
   RowBox[{
    RowBox[{"\"\<pdfLaTeX\>\"", "->", "\"\</usr/local/bin/pdflatex\>\""}], 
    ",", 
    RowBox[{"\"\<Ghostscript\>\"", "->", "\"\</usr/local/bin/gs\>\""}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"Plot", ",", 
    RowBox[{"FrameTicks", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"LinTicks", ",", "None"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"LinTicks", ",", "None"}], "}"}]}], "}"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"MaTeX", ",", 
    RowBox[{"Magnification", "->", "1.5"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"makeunit", "[", 
   RowBox[{"label_", ",", "unit_"}], "]"}], ":=", 
  RowBox[{"MaTeX", "[", 
   RowBox[{"StringJoin", "[", 
    RowBox[{
    "label", ",", "\"\<\\\\ [\\\\textrm{\>\"", ",", "unit", ",", 
     "\"\<}]\>\""}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"makeframelabel", "[", 
   RowBox[{"xlabel_", ",", "xunit_", ",", "ylabel_", ",", "yunit_"}], "]"}], ":=", 
  RowBox[{"FrameLabel", "->", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"makeunit", "[", 
      RowBox[{"xlabel", ",", "xunit"}], "]"}], ",", 
     RowBox[{"makeunit", "[", 
      RowBox[{"ylabel", ",", "yunit"}], "]"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Get", "[", "\"\</Users/user1/Downloads/04/2022 05 26/WilsonInput.wl\>\"", 
   "]"}], ";"}]}], "Input",

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Assume", " ", "constant", " ", "gradient", " ", "structure"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "5.14", " ", "group", " ", "velocity", " ", "required", " ", "to", " ", 
    "product", " ", "constant", " ", "accelearting", " ", "gradient"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vgConstantGradient", "[", 
     RowBox[{"r_", ",", "L_", ",", "tau_", ",", "Q_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"omega", "*", 
     RowBox[{"L", "/", "Q"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"1", "/", "L"}], "*", 
         RowBox[{"Quantity", "[", 
          RowBox[{"z", ",", "\"\<Meters\>\""}], "]"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"E", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "*", "tau"}], ")"}]}]}], ")"}]}]}], ")"}], 
      "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "tau"}], ")"}]}]}], ")"}]}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"functions", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"functions", ",", 
       RowBox[{
        RowBox[{"vgConstantGradient", "[", 
         RowBox[{"r", ",", "L", ",", "tauu", ",", "Q", ",", "z"}], "]"}], "/",
         "c"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"tauu", ",", "tauList"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{"functions", ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"QuantityMagnitude", "[", "L", "]"}]}], "}"}], ",", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"makeframelabel", "[", 
       RowBox[{
       "\"\<z\>\"", ",", "\"\<m\>\"", ",", "\"\<v_g\>\"", ",", "\"\<c\>\""}], 
       "]"}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", "plotstyle"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{

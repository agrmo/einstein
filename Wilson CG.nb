Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Fig", " ", "5.2", " ", "normalized", " ", "net", " ", "voltage", " ", 
     "gain", " ", "as", " ", "function", " ", "of", " ", "normalized", " ", 
     "beam", " ", "current"}], ",", " ", 
    RowBox[{"as", " ", "function", " ", "of", " ", "tau"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"iZeroFromNormalized", "[", "iNormalized_", "]"}], ":=", 
    RowBox[{"iNormalized", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "*", "L"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ")"}]}], "*", 
     RowBox[{"pzero", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vNormalizedConstantGradient", "[", 
     RowBox[{
     "r_", ",", "L_", ",", "tau_", ",", "pzero_", ",", "iNormalized_"}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"vLoadedConstantGradient", "[", 
      RowBox[{"r", ",", "L", ",", "tau", ",", "pzero", ",", 
       RowBox[{"iZeroFromNormalized", "[", "iNormalized", "]"}]}], "]"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "*", "L", "*", "pzero"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vNormalizedConstantGradient", "[", 
        RowBox[{
        "r", ",", "L", ",", "0.25", ",", "pzero", ",", "iNormalized"}], "]"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"vNormalizedConstantGradient", "[", 
        RowBox[{"r", ",", "L", ",", "0.5", ",", "pzero", ",", "iNormalized"}],
         "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"vNormalizedConstantGradient", "[", 
        RowBox[{"r", ",", "L", ",", "1.0", ",", "pzero", ",", "iNormalized"}],
         "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"vNormalizedConstantGradient", "[", 
        RowBox[{"r", ",", "L", ",", "2.0", ",", "pzero", ",", "iNormalized"}],
         "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{"plots", ",", 
     RowBox[{"{", 
      RowBox[{"iNormalized", ",", "0", ",", "5"}], "}"}], ",", 

Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Load", " ", "MaTeX"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"See", " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"github", ".", "com"}], "/", "szhorvat"}], "/", "MaTeX"}], " ",
      "to", " ", "install"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Get", "[", "\"\<MaTeX`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ConfigureMaTeX", "[", 
     RowBox[{
      RowBox[{"\"\<pdfLaTeX\>\"", "->", "\"\</usr/local/bin/pdflatex\>\""}], 
      ",", 
      RowBox[{"\"\<Ghostscript\>\"", "->", "\"\</usr/local/bin/gs\>\""}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetOptions", "[", 
     RowBox[{"MaTeX", ",", 
      RowBox[{"Magnification", "->", "1.5"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"makeunit", "[", 
      RowBox[{"label_", ",", "unit_"}], "]"}], ":=", 
     RowBox[{"MaTeX", "[", 
      RowBox[{"StringJoin", "[", 
       RowBox[{
       "label", ",", "\"\<\\\\ [\\\\textrm{\>\"", ",", "unit", ",", 
        "\"\<}]\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeframelabel", "[", 
      RowBox[{"xlabel_", ",", "xunit_", ",", "ylabel_", ",", "yunit_"}], 
      "]"}], ":=", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"makeunit", "[", 
         RowBox[{"xlabel", ",", "xunit"}], "]"}], ",", 
        RowBox[{"makeunit", "[", 
         RowBox[{"ylabel", ",", "yunit"}], "]"}]}], "}"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.862615676814228*^9, 3.862615681433262*^9}, 

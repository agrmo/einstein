Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "5.12", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"powerLconstantgradientUnloaded", "[", 
      RowBox[{"pzero_", ",", "tau_"}], "]"}], ":=", 
     RowBox[{"pzero", "*", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "*", "tau"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"powerConstantGradientUnloaded", "[", 
      RowBox[{"pzero_", ",", "tau_", ",", "z_", ",", "L_"}], "]"}], ":=", 
     RowBox[{"pzero", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"pzero", "-", 
         RowBox[{"powerLconstantgradientUnloaded", "[", 
          RowBox[{"pzero", ",", "tau"}], "]"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Quantity", "[", 
          RowBox[{"z", ",", "\"\<Meters\>\""}], "]"}], "/", "L"}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"functions", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"functions", ",", 
       RowBox[{
        RowBox[{"powerConstantGradientUnloaded", "[", 
         RowBox[{"pzero", ",", "tauu", ",", "z", ",", "L"}], "]"}], "/", 
        "mega"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"tauu", ",", "tauList"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{"functions", ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"QuantityMagnitude", "[", "L", "]"}]}], "}"}], ",", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"makeframelabel", "[", 
       RowBox[{
       "\"\<z\>\"", ",", "\"\<m\>\"", ",", "\"\<P\>\"", ",", "\"\<MW\>\""}], 
       "]"}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", "plotstyle"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.859921320037122*^9, 3.8599213910216007`*^9}, {

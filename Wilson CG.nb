Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Make", " ", "text", " ", "file", " ", "that", " ", "has", " ", 
    "numCavity", " ", "number", " ", "of", " ", "lines", " ", "for", " ", 
    "HELLWEG", " ", "to", " ", "use", " ", "in", " ", "its", " ", 
    RowBox[{"simulation", ".", " ", "This"}], " ", "will", " ", "make", " ", 
    "the", " ", 
    RowBox[{"Ohm", "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}], " ", "and", " ", "alpha", "*", 
    RowBox[{"lambda", "^", 
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}]}], " ", 
    RowBox[{"entries", ".", " ", "The"}], " ", "rest", " ", "needs", " ", 
    "to", " ", "be", " ", "filled", " ", "in", " ", "by", " ", 
    RowBox[{"you", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hellwegTable", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"QuantityMagnitude", "[", 
          RowBox[{"hellweg1", "[", 
           RowBox[{
           "lambda", ",", "r", ",", "Q", ",", "L", ",", "cgTau", ",", "z"}], 
           "]"}], "]"}], ",", 
         RowBox[{"QuantityMagnitude", "[", 
          RowBox[{"hellweg2", "[", 
           RowBox[{
           "r", ",", "L", ",", "cgTau", ",", "Q", ",", "z", ",", "lambda"}], 
           "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", 
         RowBox[{"QuantityMagnitude", "[", "L", "]"}], ",", 
         RowBox[{"QuantityMagnitude", "[", "cellLength", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"On", "[", "Assert", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Assert", "[", 
     RowBox[{
      RowBox[{"Length", "[", "hellwegTable", "]"}], "==", "numCavity"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         "\"\<hellwegTable.txt\>\""}], "}"}], "]"}], ",", "hellwegTable", 
      ",", "\"\<Table\>\""}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.862879428805732*^9, 3.862879485401609*^9}, {
  3.862879544035774*^9, 3.8628795447669067`*^9}, {3.862879914063842*^9, 

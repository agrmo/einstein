Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "invariant", " ", "on", " ", "page", " ", "10", " ", "of", " ",
     "Hellweg", " ", 
    RowBox[{"Manual", ".", " ", "Call"}], " ", "it", " ", 
    RowBox[{"hellweg1", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hellweg1", "[", 
     RowBox[{
     "lambda_", ",", "r_", ",", "Q_", ",", "L_", ",", "tau_", ",", "z_"}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi", "*", "lambda", "*", "r"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"Q", "*", 
         RowBox[{"betaVg", "[", 
          RowBox[{"r", ",", "L", ",", "tau", ",", "Q", ",", "z"}], "]"}]}], 
        ")"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"hellweg1", "[", 
      RowBox[{
      "lambda", ",", "r", ",", "Q", ",", "L", ",", "cgTau", ",", "z"}], "]"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", 
       RowBox[{"QuantityMagnitude", "[", "L", "]"}]}], "}"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"makeunit", "[", 
          RowBox[{"\"\<z\>\"", ",", "\"\<m\>\""}], "]"}], "]"}], ",", 
        RowBox[{"MaTeX", "[", "\"\<[\\\\sqrt{\\\\Omega}]\>\"", "]"}]}], 
       "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.862876411160509*^9, 3.8628764325026703`*^9}, {
   3.862878888141007*^9, 3.862878905094859*^9}, {3.8628795853227673`*^9, 
